rules_version = '2';
// Firebase konsolunda yayınlı kuralların kopyası (2026-11-24). Değişiklik: konsol > Firestore > Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "ahmet.klic548@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /newsletter/{email} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Ürünler, ortak kodları (_ortaklar), gizli ürünler: herkes okur, sadece admin yazar
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kafile paneli (/kafile-panel?k=ANAHTAR): belge kimliği = sha256(anahtar) → sadece linki bilen okur.
    // Listeleme ve yazma sadece admin (Ortak Kodları sayfası günceller).
    match /ortakPanel/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Kartla ödeme öncesi geçici kayıt: sunucu (paytr-token) yazar, paytr-notify numarasıyla okuyup siler.
    // Numara rastgele ekli (tahmin edilemez); listeleme ve değiştirme sadece admin.
    match /siparisTakip/{orderId} {
      allow create, get, delete: if true;
      allow list, update: if isAdmin();
    }

    // Siparişler: site sunucusu yeni sipariş YARATIR (kart / kapıda ödeme / kafile listesi);
    // var olan siparişi değiştirmek, silmek ve okumak sadece admin.
    match /siparisler/{orderId} {
      allow create: if request.resource.data.orderId == orderId
        && request.resource.data.paymentMethod in ["kart", "kapida-odeme", "kafile-toptan"]
        && request.resource.data.status in ["success", "kapida-odeme", "yeni"];
      allow read, update, delete: if isAdmin();
    }
    // Yurt disi toptan musteri + proforma: sadece admin (2026-11-24)
    match /yurtdisi/{id} { allow read, write: if isAdmin(); }
  }
}
